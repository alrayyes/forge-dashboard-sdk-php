{
    "name": "alrayyes/forge-dashboard-sdk-php",
    "version": "0.1.0",
    "description": "Aggregates every repository the configured GitHub and Forgejo accounts have write access to into one read-only view: open pull requests (with CI status), open issues, and per-forge reachability. The backend holds both forges' credentials; the frontend only ever calls the endpoints below.",
    "keywords": [
        "openapitools",
        "openapi-generator",
        "openapi",
        "php",
        "sdk",
        "rest",
        "api"
    ],
    "homepage": "https://openapi-generator.tech",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenAPI",
            "homepage": "https://openapi-generator.tech"
        }
    ],
    "require": {
        "php": "^8.1",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "guzzlehttp/guzzle": "^7.3",
        "guzzlehttp/psr7": "^1.7 || ^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^8.0 || ^9.0",
        "friendsofphp/php-cs-fixer": "^3.5"
    },
    "autoload": {
        "psr-4": { "ForgeDashboard\\Generated\\" : "src/" }
    },
    "autoload-dev": {
        "psr-4": { "ForgeDashboard\\Generated\\Test\\" : "test/" }
    }
}
